# ── Autenticación ──────────────────────────────────────────────
# Clave secreta para firmar tokens JWT (mínimo 32 caracteres)
AUTH_SECRET=cambia_esto_por_una_clave_secreta_larga_de_32_caracteres

# Credenciales del administrador
ADMIN_EMAIL=admin@entrelineas.org
# Hash bcrypt de la contraseña. Generar con:
#   node -e "const b=require('bcryptjs'); b.hash('tu_password',12).then(console.log)"
ADMIN_PASSWORD_HASH=$2b$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Galería (para commits automáticos) ─────────────────────────
GIT_USER_NAME=Entrelíneas Admin
GIT_USER_EMAIL=admin@entrelineas.org
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=jessicaborda/Fundacion_Entrelineas
GITHUB_BRANCH=main

# ── Media ───────────────────────────────────────────────────────
MEDIA_STORAGE_PATH=./public/media

# ── Blog (opcional, si se migra de .md a base de datos) ────────
# DATABASE_URL=file:./entrelineas.db
