# Base de datos PostgreSQL
DATABASE_URL=postgres://entrelineas:entrelineas_dev@localhost:5432/entrelineas

# JWT — cadena aleatoria de mínimo 32 caracteres
AUTH_SECRET=cambia_esto_por_una_cadena_aleatoria_segura

# Primer admin — solo se aplica si no existe ningún usuario en la DB al arrancar
SEED_ADMIN_EMAIL=admin@fundacionentrelineas.com
SEED_ADMIN_PASSWORD=contraseña_segura_minimo_8_caracteres
SEED_ADMIN_NAME=Administrador

# Git push (módulo de galería)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=jessicaborda/Fundacion_Entrelineas
GITHUB_BRANCH=main
GIT_USER_NAME=Entrelíneas Admin
GIT_USER_EMAIL=admin@fundacionentrelineas.com

# Instagram Graph API (sección "Actividades" del home)
# La cuenta de IG debe ser Business/Creator y estar vinculada a una página de Facebook.
# Usar un System User token generado en Meta Business Manager (Business Settings →
# Users → System Users → Add → generar token con permiso instagram_basic sobre la
# app). Este tipo de token NO expira por tiempo, así que no requiere refresh
# automático — solo se revoca si alguien lo hace manualmente en Business Manager
# o si se le quita el permiso a la app.
INSTAGRAM_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxx
INSTAGRAM_BUSINESS_ACCOUNT_ID=17841400000000000
