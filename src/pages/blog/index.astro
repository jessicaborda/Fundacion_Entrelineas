---
export const prerender = false;
import { db } from '../../lib/db';
import { posts as postsTable } from '../../lib/schema';
import { eq, desc } from 'drizzle-orm';
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionLabel from '@components/atoms/SectionLabel.astro';

const rows = await db
  .select()
  .from(postsTable)
  .where(eq(postsTable.status, 'published'))
  .orderBy(desc(postsTable.pubDate));

const categories = ['Artículo', 'Ensayo', 'Poema', 'Reseña', 'Comentario crítico'] as const;

const countByCategory = categories.reduce<Record<string, number>>((acc, cat) => {
  acc[cat] = rows.filter(p => p.category === cat).length;
  return acc;
}, {});
---

<BaseLayout title="Blog | Entrelíneas" description="Artículos, ensayos, poemas y reflexiones de la Fundación Cultural Entrelíneas.">
  <div class="blog-index">

    <div class="blog-index__hero">
      <div class="blog-index__hero-inner">
        <SectionLabel label="Blog" />
        <h1 class="blog-index__title">
          Escrituras <em class="blog-index__title-em">entre líneas</em>
        </h1>
        <p class="blog-index__description">
          Ensayos, artículos, poemas, reseñas y comentarios críticos escritos por
          los integrantes y colaboradores de la Fundación Cultural Entrelíneas.
        </p>
      </div>
    </div>

    <div class="blog-index__body">
      <div class="blog-index__filters" role="group" aria-label="Filtrar por categoría">
        <button
          class="blog-index__filter blog-index__filter--active"
          data-filter="todos"
          aria-pressed="true"
        >
          Todos
          <span class="blog-index__filter-count">{rows.length}</span>
        </button>
        {categories.map(cat => countByCategory[cat] > 0 && (
          <button
            class="blog-index__filter"
            data-filter={cat}
            aria-pressed="false"
          >
            {cat}
            <span class="blog-index__filter-count">{countByCategory[cat]}</span>
          </button>
        ))}
      </div>

      <div class="blog-index__grid" id="blog-grid">
        {rows.map(post => {
          const date = new Date(post.pubDate).toLocaleDateString('es-CO', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          });
          return (
            <article class="blog-card" data-category={post.category}>
              <div class="blog-card__header">
                <span class="blog-card__category">{post.category}</span>
                <time class="blog-card__date" datetime={post.pubDate}>
                  {date}
                </time>
              </div>
              <h2 class="blog-card__title">
                <a href={`/Fundacion_Entrelineas/blog/${post.slug}/`}>{post.title}</a>
              </h2>
              <p class="blog-card__description">{post.description}</p>
              <div class="blog-card__footer">
                <span class="blog-card__author">{post.author}</span>
                <a href={`/Fundacion_Entrelineas/blog/${post.slug}/`} class="blog-card__link">
                  Leer más →
                </a>
              </div>
            </article>
          );
        })}
      </div>

      {rows.length === 0 && (
        <p class="blog-index__empty">
          No hay publicaciones disponibles todavía.
        </p>
      )}

      <p class="blog-index__empty" id="blog-empty" hidden>
        No hay publicaciones en esta categoría todavía.
      </p>
    </div>

  </div>
</BaseLayout>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('.blog-index__filter');
  const cards = document.querySelectorAll<HTMLElement>('.blog-card');
  const empty = document.getElementById('blog-empty');

  filters.forEach(btn => {
    btn.addEventListener('click', () => {
      const selected = btn.dataset.filter!;

      filters.forEach(f => {
        f.classList.remove('blog-index__filter--active');
        f.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('blog-index__filter--active');
      btn.setAttribute('aria-pressed', 'true');

      let visible = 0;
      cards.forEach(card => {
        const match = selected === 'todos' || card.dataset.category === selected;
        card.hidden = !match;
        if (match) visible++;
      });

      if (empty) empty.hidden = visible > 0;
    });
  });
</script>

<style lang="scss">
  .blog-index {
    background-color: $color-editorial;
    min-height: 100vh;
  }

  // Hero
  .blog-index__hero {
    padding: $spacing-section;
    border-bottom: 1px solid rgba(7, 5, 35, 0.08);
  }

  .blog-index__hero-inner {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: $spacing-lg;
  }

  .blog-index__title {
    font-family: $font-family-serif;
    font-weight: 500;
    font-size: clamp(2.4rem, 5vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: $color-text-dark;
    margin: 0;
  }

  .blog-index__title-em {
    font-style: italic;
    font-weight: 400;
  }

  .blog-index__description {
    font-family: $font-family;
    font-size: $font-size-lg;
    line-height: 1.6;
    color: rgba(7, 5, 35, 0.65);
    margin: 0;
    max-width: 580px;
  }

  // Body
  .blog-index__body {
    max-width: 1120px;
    margin: 0 auto;
    padding: $spacing-section $spacing-xl;
    display: flex;
    flex-direction: column;
    gap: $spacing-2xl;
  }

  // Filtros
  .blog-index__filters {
    display: flex;
    flex-wrap: wrap;
    gap: $spacing-sm;
  }

  .blog-index__filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem $spacing-lg;
    border: 1px solid rgba(7, 5, 35, 0.2);
    background: none;
    color: rgba(7, 5, 35, 0.65);
    font-family: $font-family;
    font-size: $font-size-sm;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;

    &:hover {
      border-color: $color-text-dark;
      color: $color-text-dark;
    }

    &--active {
      background: $color-text-dark;
      color: $color-primary;
      border-color: $color-text-dark;
      font-weight: 700;

      .blog-index__filter-count {
        background: rgba(251, 210, 0, 0.2);
        color: $color-primary;
      }
    }
  }

  .blog-index__filter-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(7, 5, 35, 0.08);
    color: rgba(7, 5, 35, 0.5);
    font-size: 0.7rem;
    font-weight: 700;
    min-width: 1.3rem;
    height: 1.3rem;
    padding: 0 0.3rem;
    line-height: 1;
  }

  // Grid
  .blog-index__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: $spacing-xl;
  }

  // Tarjeta
  .blog-card {
    background: #ffffff;
    border: 1px solid rgba(7, 5, 35, 0.1);
    padding: $spacing-xl;
    display: flex;
    flex-direction: column;
    gap: $spacing-md;
    transition: box-shadow 0.25s ease, transform 0.25s ease;

    &[hidden] { display: none; }

    &:hover {
      box-shadow: 0 8px 24px rgba(7, 5, 35, 0.08);
      transform: translateY(-2px);
    }
  }

  .blog-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: $spacing-sm;
    flex-wrap: wrap;
  }

  .blog-card__category {
    display: inline-block;
    background: $color-primary;
    color: $color-text-dark;
    font-family: $font-family;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem $spacing-sm;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .blog-card__date {
    font-family: $font-family;
    font-size: $font-size-sm;
    color: rgba(7, 5, 35, 0.45);
  }

  .blog-card__title {
    font-family: $font-family-heading;
    font-size: $font-size-xl;
    font-weight: 500;
    margin: 0;
    line-height: 1.3;
    flex: 1;

    a {
      color: $color-text-dark;
      text-decoration: none;
      transition: color 0.2s ease;

      &:hover { color: $color-accent; }
    }
  }

  .blog-card__description {
    font-family: $font-family;
    font-size: $font-size-base;
    color: rgba(7, 5, 35, 0.65);
    margin: 0;
    line-height: 1.65;
    flex: 1;
  }

  .blog-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: $spacing-md;
    border-top: 1px solid rgba(7, 5, 35, 0.08);
    flex-wrap: wrap;
    gap: $spacing-sm;
  }

  .blog-card__author {
    font-family: $font-family;
    font-size: $font-size-sm;
    color: rgba(7, 5, 35, 0.45);
  }

  .blog-card__link {
    font-family: $font-family;
    font-size: $font-size-sm;
    font-weight: 700;
    color: $color-text-dark;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: $color-primary;
    text-decoration-thickness: 2px;
    transition: opacity 0.2s ease;

    &:hover { opacity: 0.7; }
  }

  .blog-index__empty {
    text-align: center;
    color: rgba(7, 5, 35, 0.45);
    font-family: $font-family;
    font-size: $font-size-base;
    padding: $spacing-section 0;

    &[hidden] { display: none; }
  }

  @media (max-width: 1024px) {
    .blog-index__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .blog-index__hero {
      padding: $spacing-xl;
    }

    .blog-index__body {
      padding: $spacing-xl;
    }

    .blog-index__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
