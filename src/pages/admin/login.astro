---
export const prerender = false;

import { getUserFromRequest } from '../../lib/auth';
import { Image } from 'astro:assets';
import logo from '@assets/logo.svg';

const user = await getUserFromRequest(Astro.request);
if (user) return Astro.redirect(`/admin/`);
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Acceso — Admin Entrelíneas</title>
  <link rel="icon" href="/logo.svg" />
  <link rel="preconnect" href="https://api.fontshare.com" />
  <link
    href="https://api.fontshare.com/v2/css?f[]=chillax@400,500,600,700&f[]=amulya@400,500,600,700&display=swap"
    rel="stylesheet"
  />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --primary:   #FBD200;
      --dark:      #070523;
      --editorial: #f2f2f2;
      --white:     #ffffff;
      --muted:     rgba(7,5,35,0.45);
      --border:    rgba(7,5,35,0.15);
      --danger:    #c0392b;
      --font:         'Inter', system-ui, sans-serif;
      --font-heading: 'Chillax', sans-serif;
      --font-serif:   'Amulya', sans-serif;
    }

    body {
      font-family: var(--font);
      background: var(--dark);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }

    .login-card {
      background: var(--white);
      width: 100%;
      max-width: 400px;
      border-top: 4px solid var(--primary);
      padding: 2.5rem 2rem 2rem;
    }

    .login-brand {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.375rem;
      margin-bottom: 2rem;
    }

    .login-brand img { height: 32px; width: auto; }

    .login-brand__label {
      font-family: var(--font-heading);
      font-size: 0.6rem;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--muted);
    }

    h1 {
      font-family: var(--font-serif);
      font-size: 1.4rem;
      font-weight: 500;
      color: var(--dark);
      margin-bottom: 1.75rem;
      line-height: 1.25;
    }

    .field { display: flex; flex-direction: column; gap: 0.375rem; margin-bottom: 1.125rem; }

    label {
      font-family: var(--font-heading);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      color: var(--dark);
    }

    input {
      padding: 0.55rem 0.75rem;
      border: 1px solid var(--border);
      border-bottom: 2px solid rgba(7,5,35,0.25);
      font-family: var(--font);
      font-size: 0.9rem;
      color: var(--dark);
      background: var(--white);
      outline: none;
      width: 100%;
      transition: border-color 0.15s, border-bottom-color 0.15s;
    }
    input:focus {
      border-color: var(--dark);
      border-bottom-color: var(--primary);
    }

    .btn-submit {
      margin-top: 0.5rem;
      width: 100%;
      padding: 0.7rem 1rem;
      background: var(--dark);
      color: var(--primary);
      font-family: var(--font-heading);
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      border: none;
      cursor: pointer;
      transition: opacity 0.15s;
    }
    .btn-submit:hover { opacity: 0.85; }
    .btn-submit:disabled { opacity: 0.5; cursor: not-allowed; }

    .error {
      display: none;
      margin-top: 1rem;
      padding: 0.625rem 0.875rem;
      background: rgba(192,57,43,0.08);
      border-left: 3px solid var(--danger);
      font-family: var(--font);
      font-size: 0.8rem;
      color: var(--danger);
    }
    .error--visible { display: block; }

    .login-footer {
      margin-top: 2rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--border);
      text-align: center;
    }
    .login-footer a {
      font-family: var(--font-heading);
      font-size: 0.72rem;
      color: var(--muted);
      text-decoration: none;
      letter-spacing: 0.04em;
      transition: color 0.15s;
    }
    .login-footer a:hover { color: var(--dark); }
  </style>
</head>
<body>
  <div class="login-card">
    <div class="login-brand">
      <Image src={logo} alt="Entrelíneas" />
      <span class="login-brand__label">Panel de administración</span>
    </div>

    <h1>Iniciar sesión</h1>

    <form id="login-form" novalidate>
      <div class="field">
        <label for="email">Correo electrónico</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
          placeholder="admin@fundacionentrelineas.com"
        />
      </div>

      <div class="field">
        <label for="password">Contraseña</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
        />
      </div>

      <button type="submit" class="btn-submit" id="submit-btn">Entrar</button>

      <div class="error" id="error-msg" role="alert"></div>
    </form>

    <div class="login-footer">
      <a href="/">← Volver al sitio</a>
    </div>
  </div>

  <script>
    const form = document.getElementById('login-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const errorMsg = document.getElementById('error-msg') as HTMLDivElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMsg.classList.remove('error--visible');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Entrando…';

      const email = (document.getElementById('email') as HTMLInputElement).value.trim();
      const password = (document.getElementById('password') as HTMLInputElement).value;

      try {
        const res = await fetch(`/api/auth/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });

        if (res.ok) {
          window.location.href = `/admin/`;
        } else {
          const data = await res.json();
          errorMsg.textContent = data.error ?? 'Error al iniciar sesión';
          errorMsg.classList.add('error--visible');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Entrar';
        }
      } catch {
        errorMsg.textContent = 'Error de conexión. Intenta de nuevo.';
        errorMsg.classList.add('error--visible');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Entrar';
      }
    });
  </script>
</body>
</html>
