---
import AdminLayout from '@layouts/AdminLayout.astro';

// Imágenes actualmente visibles en la sección Galería (Gallery.astro)
const activeImages = [
  { file: 'img_01.jpg', alt: 'Tertulia literaria Entrelíneas' },
  { file: 'img_05.jpg', alt: 'Encuentro cultural Entrelíneas' },
  { file: 'img_07.jpg', alt: 'Actividad Entrelíneas' },
  { file: 'img_13.jpg', alt: 'Festival de lectura' },
  { file: 'img_15.jpg', alt: 'Café filosófico' },
  { file: 'img_17.jpg', alt: 'Taller de escritura' },
  { file: 'img_19.jpg', alt: 'Promotores de lectura' },
  { file: 'img_23.jpg', alt: 'Comunidad lectora Entrelíneas' },
];

// Todas las imágenes disponibles en /public/galeria/
const allFiles = Array.from({ length: 24 }, (_, i) => `img_${String(i + 1).padStart(2, '0')}.jpg`);
const activeFiles = activeImages.map(img => img.file);
const inactiveFiles = allFiles.filter(f => !activeFiles.includes(f));
---

<AdminLayout title="Galería" activeNav="gallery">
  <div class="breadcrumb" slot="breadcrumb">
    <a href="/Fundacion_Entrelineas/admin/">Publicaciones</a>
    <span class="breadcrumb__sep">›</span>
    <span class="breadcrumb__current">Galería</span>
  </div>

  <div class="gallery-admin">

    <!-- Encabezado -->
    <div class="page-header">
      <div>
        <h1 class="page-title">Galería de imágenes</h1>
        <p class="page-subtitle">Gestiona las imágenes que aparecen en la sección Galería del sitio. Máximo 8 imágenes activas.</p>
      </div>
      <div class="page-header__note">
        <span class="note-tag">Backend pendiente</span>
        Los cambios aquí son visuales — para aplicarlos, edita <code>Gallery.astro</code>.
      </div>
    </div>

    <!-- Stats -->
    <div class="stats-row">
      <div class="stat-chip">
        <span class="stat-chip__n" id="stat-active">{activeImages.length}</span>
        <span class="stat-chip__label">Activas</span>
      </div>
      <div class="stat-chip">
        <span class="stat-chip__n">{allFiles.length}</span>
        <span class="stat-chip__label">Disponibles</span>
      </div>
      <div class="stat-chip stat-chip--warn" id="stat-limit-chip" style="display:none">
        <span class="stat-chip__n">8/8</span>
        <span class="stat-chip__label">Límite alcanzado</span>
      </div>
    </div>

    <!-- Grid activas -->
    <section class="section-block">
      <div class="section-block__header">
        <h2 class="section-title">Imágenes activas <span class="count-badge" id="active-count">{activeImages.length}/8</span></h2>
        <p class="section-hint">Arrastra para reordenar · Haz clic en ✕ para quitar una imagen</p>
      </div>

      <div class="img-grid" id="active-grid">
        {activeImages.map((img, i) => (
          <div class="img-card img-card--active" data-file={img.file} draggable="true">
            <img
              src={`/Fundacion_Entrelineas/galeria/${img.file}`}
              alt={img.alt}
              class="img-card__photo"
              loading="lazy"
            />
            <div class="img-card__overlay">
              <span class="img-card__name">{img.file}</span>
              <button class="img-card__remove" aria-label={`Quitar ${img.file}`} data-file={img.file}>✕</button>
            </div>
            {i === 0 && <span class="img-card__badge">Destacada</span>}
          </div>
        ))}
      </div>
    </section>

    <!-- Grid disponibles -->
    <section class="section-block">
      <div class="section-block__header">
        <h2 class="section-title">Imágenes disponibles <span class="count-badge count-badge--muted">{inactiveFiles.length}</span></h2>
        <p class="section-hint">Haz clic en + para agregar a la galería activa</p>
      </div>

      <div class="img-grid" id="inactive-grid">
        {inactiveFiles.map(file => (
          <div class="img-card img-card--inactive" data-file={file}>
            <img
              src={`/Fundacion_Entrelineas/galeria/${file}`}
              alt={file}
              class="img-card__photo"
              loading="lazy"
            />
            <div class="img-card__overlay">
              <span class="img-card__name">{file}</span>
              <button class="img-card__add" aria-label={`Agregar ${file}`} data-file={file}>+</button>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Panel de código generado -->
    <section class="section-block">
      <div class="section-block__header">
        <h2 class="section-title">Código para copiar</h2>
        <p class="section-hint">Copia este array en <code>src/components/organisms/Gallery.astro</code> para aplicar los cambios</p>
      </div>
      <div class="code-panel">
        <button class="code-copy-btn" id="copy-btn" aria-label="Copiar código">Copiar</button>
        <pre class="code-block" id="code-output"></pre>
      </div>
    </section>

  </div>
</AdminLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font);
    font-size: 0.78rem;
    color: var(--muted);
  }
  .breadcrumb a { color: var(--muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--dark); }
  .breadcrumb__sep { opacity: 0.4; }
  .breadcrumb__current { color: var(--dark); font-weight: 600; }

  .gallery-admin {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Header */
  .page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .page-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--dark);
    margin: 0 0 0.375rem;
  }
  .page-subtitle {
    font-family: var(--font);
    font-size: 0.82rem;
    color: var(--muted);
    margin: 0;
  }
  .page-header__note {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    text-align: right;
    font-family: var(--font);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .note-tag {
    display: inline-block;
    background: rgba(7,5,35,0.06);
    color: var(--muted);
    font-family: var(--font-heading);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    align-self: flex-end;
  }
  code {
    font-family: monospace;
    font-size: 0.8em;
    background: rgba(7,5,35,0.06);
    padding: 0.1rem 0.3rem;
  }

  /* Stats */
  .stats-row {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .stat-chip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--white);
    border: 1px solid var(--border);
    border-top: 3px solid var(--dark);
    padding: 0.625rem 1rem;
  }
  .stat-chip--warn { border-top-color: #c0392b; }
  .stat-chip__n {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1;
    color: var(--dark);
  }
  .stat-chip__label {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Sections */
  .section-block {
    background: var(--white);
    border: 1px solid var(--border);
    border-top: 3px solid var(--dark);
  }
  .section-block__header {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .section-title {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--dark);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .section-hint {
    font-family: var(--font);
    font-size: 0.75rem;
    color: var(--muted);
    margin: 0;
  }
  .count-badge {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    background: var(--primary);
    color: var(--dark);
    padding: 0.15rem 0.45rem;
  }
  .count-badge--muted {
    background: rgba(7,5,35,0.07);
    color: var(--muted);
  }

  /* Image grid */
  .img-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.75rem;
    padding: 1.25rem;
    min-height: 80px;
  }

  .img-card {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    cursor: pointer;
  }
  .img-card--active { outline: 2px solid var(--primary); }
  .img-card--inactive { outline: 1px solid var(--border); }
  .img-card--drag-over { outline: 2px dashed var(--primary); opacity: 0.7; }

  .img-card__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.2s ease;
  }
  .img-card:hover .img-card__photo { transform: scale(1.04); }

  .img-card__overlay {
    position: absolute;
    inset: 0;
    background: rgba(7,5,35,0.55);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0.375rem 0.5rem;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .img-card:hover .img-card__overlay { opacity: 1; }

  .img-card__name {
    font-family: var(--font);
    font-size: 0.65rem;
    color: rgba(255,255,255,0.85);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .img-card__remove,
  .img-card__add {
    background: var(--primary);
    color: var(--dark);
    border: none;
    width: 1.5rem;
    height: 1.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.15s;
  }
  .img-card__remove:hover { background: #c0392b; color: #fff; }
  .img-card__add:hover    { background: #1a7a4a; color: #fff; }

  .img-card__badge {
    position: absolute;
    top: 0.375rem;
    left: 0.375rem;
    background: var(--primary);
    color: var(--dark);
    font-family: var(--font-heading);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.15rem 0.4rem;
  }

  /* Code panel */
  .code-panel {
    position: relative;
    padding: 1.25rem;
  }
  .code-block {
    background: var(--dark);
    color: rgba(251,210,0,0.9);
    font-family: monospace;
    font-size: 0.78rem;
    line-height: 1.6;
    padding: 1.25rem;
    overflow-x: auto;
    white-space: pre;
    margin: 0;
    min-height: 60px;
  }
  .code-copy-btn {
    position: absolute;
    top: 1.75rem;
    right: 1.75rem;
    background: var(--primary);
    color: var(--dark);
    border: none;
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.75rem;
    cursor: pointer;
    z-index: 1;
    transition: background 0.15s;
  }
  .code-copy-btn:hover { background: #e6c100; }
  .code-copy-btn--copied { background: #1a7a4a; color: #fff; }
</style>

<script>
  // ── Estado ──────────────────────────────────────────────
  const MAX = 8;

  // Leer imágenes activas iniciales desde el DOM
  let activeImages: string[] = Array.from(
    document.querySelectorAll<HTMLElement>('#active-grid .img-card')
  ).map(el => el.dataset.file!);

  // ── Referencias DOM ──────────────────────────────────────
  const activeGrid   = document.getElementById('active-grid')!;
  const inactiveGrid = document.getElementById('inactive-grid')!;
  const activeCount  = document.getElementById('active-count')!;
  const statActive   = document.getElementById('stat-active')!;
  const limitChip    = document.getElementById('stat-limit-chip')!;
  const codeOutput   = document.getElementById('code-output')!;
  const copyBtn      = document.getElementById('copy-btn')!;

  // ── Render del código generado ───────────────────────────
  function updateCode() {
    const lines = activeImages.map(
      (f, i) => `  { src: '/Fundacion_Entrelineas/galeria/${f}', alt: '' },`
    );
    codeOutput.textContent = `const images = [\n${lines.join('\n')}\n];`;
  }

  function updateCounters() {
    activeCount.textContent = `${activeImages.length}/8`;
    statActive.textContent  = String(activeImages.length);
    limitChip.style.display = activeImages.length >= MAX ? '' : 'none';
  }

  // ── Quitar imagen activa ─────────────────────────────────
  function removeImage(file: string) {
    activeImages = activeImages.filter(f => f !== file);

    // Mover card al grid inactivo
    const card = activeGrid.querySelector<HTMLElement>(`[data-file="${file}"]`);
    if (card) {
      card.classList.remove('img-card--active');
      card.classList.add('img-card--inactive');
      card.querySelector('.img-card__remove')?.remove();
      card.querySelector('.img-card__badge')?.remove();

      const overlay = card.querySelector('.img-card__overlay')!;
      const addBtn = document.createElement('button');
      addBtn.className  = 'img-card__add';
      addBtn.textContent = '+';
      addBtn.setAttribute('aria-label', `Agregar ${file}`);
      addBtn.dataset.file = file;
      addBtn.addEventListener('click', () => addImage(file));
      overlay.appendChild(addBtn);

      inactiveGrid.appendChild(card);
    }

    // Quitar badge "Destacada" de la primera si ya no está
    const first = activeGrid.querySelector<HTMLElement>('.img-card');
    activeGrid.querySelectorAll('.img-card__badge').forEach(b => b.remove());
    if (first) {
      const badge = document.createElement('span');
      badge.className   = 'img-card__badge';
      badge.textContent = 'Destacada';
      first.appendChild(badge);
    }

    updateCounters();
    updateCode();
  }

  // ── Agregar imagen ───────────────────────────────────────
  function addImage(file: string) {
    if (activeImages.length >= MAX) {
      alert('La galería ya tiene 8 imágenes. Quita una antes de agregar otra.');
      return;
    }
    activeImages.push(file);

    const card = inactiveGrid.querySelector<HTMLElement>(`[data-file="${file}"]`);
    if (card) {
      card.classList.remove('img-card--inactive');
      card.classList.add('img-card--active');
      card.querySelector('.img-card__add')?.remove();

      const overlay = card.querySelector('.img-card__overlay')!;
      const removeBtn = document.createElement('button');
      removeBtn.className   = 'img-card__remove';
      removeBtn.textContent = '✕';
      removeBtn.setAttribute('aria-label', `Quitar ${file}`);
      removeBtn.dataset.file = file;
      removeBtn.addEventListener('click', () => removeImage(file));
      overlay.appendChild(removeBtn);

      activeGrid.appendChild(card);
    }

    // Badge destacada en la primera
    activeGrid.querySelectorAll('.img-card__badge').forEach(b => b.remove());
    const first = activeGrid.querySelector<HTMLElement>('.img-card');
    if (first) {
      const badge = document.createElement('span');
      badge.className   = 'img-card__badge';
      badge.textContent = 'Destacada';
      first.appendChild(badge);
    }

    updateCounters();
    updateCode();
  }

  // ── Drag & drop para reordenar activas ──────────────────
  let dragSrc: HTMLElement | null = null;

  activeGrid.addEventListener('dragstart', e => {
    dragSrc = (e.target as HTMLElement).closest('.img-card');
    dragSrc?.classList.add('img-card--dragging');
  });
  activeGrid.addEventListener('dragend', () => {
    dragSrc?.classList.remove('img-card--dragging');
    dragSrc = null;
    activeGrid.querySelectorAll('.img-card--drag-over').forEach(el => el.classList.remove('img-card--drag-over'));
    // Actualizar orden en activeImages
    activeImages = Array.from(activeGrid.querySelectorAll<HTMLElement>('.img-card')).map(el => el.dataset.file!);
    updateCode();
  });
  activeGrid.addEventListener('dragover', e => {
    e.preventDefault();
    const target = (e.target as HTMLElement).closest<HTMLElement>('.img-card');
    if (target && target !== dragSrc) target.classList.add('img-card--drag-over');
  });
  activeGrid.addEventListener('dragleave', e => {
    const target = (e.target as HTMLElement).closest<HTMLElement>('.img-card');
    target?.classList.remove('img-card--drag-over');
  });
  activeGrid.addEventListener('drop', e => {
    e.preventDefault();
    const target = (e.target as HTMLElement).closest<HTMLElement>('.img-card');
    if (target && dragSrc && target !== dragSrc) {
      target.classList.remove('img-card--drag-over');
      activeGrid.insertBefore(dragSrc, target);
    }
  });

  // ── Bind inicial de botones ──────────────────────────────
  activeGrid.querySelectorAll<HTMLButtonElement>('.img-card__remove').forEach(btn => {
    btn.addEventListener('click', () => removeImage(btn.dataset.file!));
  });
  inactiveGrid.querySelectorAll<HTMLButtonElement>('.img-card__add').forEach(btn => {
    btn.addEventListener('click', () => addImage(btn.dataset.file!));
  });

  // ── Copiar código ────────────────────────────────────────
  copyBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(codeOutput.textContent || '').then(() => {
      copyBtn.textContent = '¡Copiado!';
      copyBtn.classList.add('code-copy-btn--copied');
      setTimeout(() => {
        copyBtn.textContent = 'Copiar';
        copyBtn.classList.remove('code-copy-btn--copied');
      }, 2000);
    });
  });

  // ── Init ─────────────────────────────────────────────────
  updateCode();
  updateCounters();
</script>
