---
// Footer — multi-column editorial layout
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__brand">
      <img
        src="/logo-light.svg"
        alt="Entrelíneas"
        class="footer__logo-img"
      />
      <blockquote class="footer__quote">
        "Lo que se lee en compañía nunca se olvida del todo."
      </blockquote>
    </div>

    <div class="footer__col">
      <h4 class="footer__col-heading">Navega</h4>
      <ul class="footer__list">
        <li><a href="/#quienes-somos" class="footer__link">Quiénes somos</a></li>
        <li><a href="/#que-hacemos" class="footer__link">Qué hacemos</a></li>
        <li><a href="/#actividades" class="footer__link">Actividades</a></li>
        <li><a href="/#galeria" class="footer__link">Galería</a></li>
        <li><a href="/#colaboradores" class="footer__link">Colaboradores</a></li>
        <li><a href="/blog/" class="footer__link">Blog</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h4 class="footer__col-heading">Encuentra</h4>
      <ul class="footer__list">
        <li><a href="/#actividades" class="footer__link">Próximos eventos</a></li>
        <li><a href="/blog/" class="footer__link">Publicaciones</a></li>
        <li><a href="/#contacto" class="footer__link">Voluntariado</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h4 class="footer__col-heading">Síguenos</h4>
      <ul class="footer__list">
        <li><a href="https://www.instagram.com/fundacion_entrelineas" target="_blank" rel="noopener" class="footer__link">Instagram</a></li>
        <li><a href="https://www.facebook.com/FundacionEntrelineas" target="_blank" rel="noopener" class="footer__link">Facebook</a></li>
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <span class="footer__copy">© 2025 Fundación Cultural Entrelíneas · Tunja, Boyacá</span>
    <div class="footer__legal">
      <a href="#aviso-legal" class="footer__legal-link">Aviso legal</a>
      <a href="#politicas" class="footer__legal-link">Políticas</a>
    </div>
  </div>
</footer>

<style lang="scss">
  .footer {
    background-color: $color-secondary;
    padding: $spacing-section $spacing-section $spacing-xl;
  }

  .footer__inner {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: $spacing-2xl;
    padding-bottom: $spacing-2xl;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: $spacing-lg;
  }

  .footer__logo-img {
    height: 36px;
    width: auto;
  }

  .footer__quote {
    font-family: $font-family-serif;
    font-style: italic;
    font-size: $font-size-base;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
    max-width: 300px;
  }

  .footer__col-heading {
    font-family: $font-family;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: $color-primary;
    margin: 0 0 $spacing-md;
  }

  .footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer__link {
    font-family: $font-family;
    font-size: $font-size-sm;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color 0.2s ease;

    &:hover {
      color: $color-primary;
    }
  }

  .footer__bottom {
    max-width: 1120px;
    margin: $spacing-xl auto 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: $spacing-md;
  }

  .footer__copy {
    font-family: $font-family;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.45);
  }

  .footer__legal {
    display: flex;
    gap: $spacing-lg;
  }

  .footer__legal-link {
    font-family: $font-family;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.45);
    text-decoration: none;
    transition: color 0.2s ease;

    &:hover {
      color: $color-text-light;
    }
  }

  @media (max-width: 900px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
      row-gap: $spacing-2xl;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .footer {
      padding: $spacing-xl $spacing-lg;
    }

    .footer__inner {
      grid-template-columns: 1fr 1fr;
      gap: $spacing-lg;
    }

    .footer__brand {
      align-items: center;
      text-align: center;
    }

    .footer__quote {
      max-width: 100%;
    }

    .footer__bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .footer__legal {
      justify-content: center;
    }

    .footer__list--row {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    }

    .footer__col:has(.footer__list--row) {
      grid-column: 1 / -1;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: $spacing-lg;
      text-align: left;
    }

    .footer__col:has(.footer__list--row) .footer__col-heading {
      margin: 0;
    }
  }
</style>
