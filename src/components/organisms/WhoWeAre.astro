---
// WhoWeAre — Quiénes somos + Historia con timeline
import SectionLabel from '@components/atoms/SectionLabel.astro';

const timeline = [
  { y: '2010', t: 'Un colectivo', d: 'El Colectivo Cultural Estanislao Zuleta reúne estudiantes universitarios para procesos de formación en literatura, cine y filosofía abiertos a todo público.' },
  { y: '2015', t: 'Fundación legal', d: 'El colectivo se constituye como Fundación Cultural Entrelíneas el 23 de febrero, manteniendo su propósito de formación sin exigir conocimiento previo.' },
  { y: '2017', t: 'Festival del libro', d: 'Nace el Festival del libro y la lectura, evento anual que combina feria del libro con programación cultural gratuita y convoca públicos de todas las edades.' },
  { y: '2018', t: 'Nueva generación', d: 'Se consolida una tercera generación surgida de las actividades abiertas al público, que refuerza los procesos de formación interna.' },
  { y: '2020', t: 'Voz digital', d: 'Entrelíneas llega a YouTube e Instagram con conferencias, conversatorios, podcast, video ensayos y cápsulas. La lectura cruza la pantalla.' },
  { y: 'Hoy', t: 'Comunidad viva', d: 'Una red de lectores, escritores y mediadores que sostienen la cultura como derecho en Tunja y más allá.' },
];
---

<section class="who-we-are" id="quienes-somos">
  <!-- Manifiesto -->
  <div class="manifesto">
    <div class="manifesto__inner">
      <SectionLabel label="Quiénes somos" light={true} />
      <h2 class="manifesto__title">
        La cultura no es un lujo. Es la
        <em class="manifesto__em">forma</em>
        en que una comunidad decide pensarse a sí misma.
      </h2>
      <p class="manifesto__body">
        La Fundación Cultural Entrelíneas es una organización cultural que busca contribuir
        a la formación de ciudadanos críticos capaces de examinar su presente a la luz de
        una lectura crítica del pasado y una proyección esperanzada del futuro. Nacimos en
        2010 como un colectivo informal y nos constituimos como fundación en 2015, sin
        abandonar nuestra apuesta: que cualquier persona, sin importar su formación previa,
        pueda conquistar su singularidad a través de la cultura.
      </p>
      <p class="manifesto__body">
        Operamos en Tunja, Boyacá, como un laboratorio de democracia que articula su
        actividad alrededor de las manifestaciones culturales —el arte, la filosofía, la
        literatura, las ciencias sociales— como herramientas para intervenir en el tejido
        social y radicalizar la democracia en sus dimensiones materiales y espirituales.
      </p>
    </div>
  </div>

  <!-- Historia con imagen + timeline -->
  <div class="history">
    <div class="history__inner">
      <SectionLabel label="Historia" />
      <h2 class="history__title">
        Quince años escribiendo, entre líneas,
        una manera <em class="history__em">nuestra</em> de habitar la cultura.
      </h2>

      <div class="history__body">
        <div class="history__image-wrap">
          <img
            src="/imgi_01.jpg"
            alt="Reunión de la fundación"
            class="history__image"
          />
          <div class="history__image-accent"></div>
        </div>

        <div class="history__timeline">
          <div class="history__timeline-line"></div>
          {timeline.map((e, i) => (
            <div class="history__event">
              <div class:list={['history__dot', { 'history__dot--active': i === timeline.length - 1 }]}></div>
              <div class="history__event-content">
                <div class="history__event-meta">
                  <span class="history__year">{e.y}</span>
                  <span class="history__event-title">{e.t}</span>
                </div>
                <p class="history__event-desc">{e.d}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .who-we-are {
    display: flex;
    flex-direction: column;
  }

  // Manifesto block (dark)
  .manifesto {
    background-color: $color-secondary;
    padding: $spacing-section;
  }

  .manifesto__inner {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: $spacing-xl;
    max-width: 800px;
  }

  .manifesto__title {
    font-family: $font-family-serif;
    font-weight: 400;
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: $color-text-light;
    margin: 0;
  }

  .manifesto__em {
    font-style: italic;
    color: $color-primary;
  }

  .manifesto__body {
    font-family: $font-family;
    font-size: $font-size-base;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
  }

  // History block (light)
  .history {
    background-color: $color-editorial;
    padding: $spacing-section;
  }

  .history__inner {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: $spacing-2xl;
  }

  .history__title {
    font-family: $font-family-serif;
    font-weight: 400;
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: $color-text-dark;
    margin: 0;
    max-width: 680px;
  }

  .history__em {
    font-style: italic;
  }

  .history__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: $spacing-section;
    align-items: stretch;
  }

  .history__image-wrap {
    position: relative;
    overflow: hidden;
  }

  .history__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .history__image-accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 20px;
    background: $color-primary;
  }

  .history__timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .history__timeline-line {
    position: absolute;
    left: 5.5px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: rgba(7, 5, 35, 0.18);
  }

  .history__event {
    position: relative;
    display: flex;
    gap: $spacing-lg;
    padding-bottom: $spacing-xl;

    &:last-child {
      padding-bottom: 0;
    }
  }

  .history__dot {
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    margin-top: 6px;
    background: $color-text-dark;
    border: 2px solid $color-primary;
    z-index: 1;

    &--active {
      background: $color-primary;
    }
  }

  .history__event-content {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .history__event-meta {
    display: flex;
    align-items: baseline;
    gap: $spacing-md;
  }

  .history__year {
    font-family: $font-family-serif;
    font-style: italic;
    font-size: 1.375rem;
    font-weight: 500;
    color: $color-text-dark;
  }

  .history__event-title {
    font-family: $font-family;
    font-size: $font-size-sm;
    font-weight: 700;
    color: $color-text-dark;
  }

  .history__event-desc {
    font-family: $font-family;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(7, 5, 35, 0.65);
    margin: 0;
    max-width: 380px;
  }

  @media (max-width: 900px) {
    .history__body {
      grid-template-columns: 1fr;
    }

    .history__image-wrap {
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 600px) {
    .manifesto,
    .history {
      padding: $spacing-xl;
    }
  }
</style>
