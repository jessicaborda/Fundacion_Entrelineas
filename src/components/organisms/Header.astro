---
// Header — editorial sticky nav
import { Image } from 'astro:assets';
import logo from '@assets/logo.svg';
---

<div class="header" id="site-header">
  <div class="header__inner">
    <a href="/" class="header__logo">
      <Image
        src={logo}
        alt="Entrelíneas"
        class="header__logo-img"
      />
    </a>

    <button
      class="header__burger"
      id="burger-btn"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="main-nav"
    >
      <span class="header__burger-bar"></span>
      <span class="header__burger-bar"></span>
      <span class="header__burger-bar"></span>
    </button>

    <nav class="header__nav" id="main-nav">
      <a href="/#quienes-somos" class="header__nav-link">Quiénes somos</a>
      <a href="/#que-hacemos" class="header__nav-link">Qué hacemos</a>
      <a href="/#actividades" class="header__nav-link">Actividades</a>
      <a href="/#galeria" class="header__nav-link">Galería</a>
      <a href="/#colaboradores" class="header__nav-link">Colaboradores</a>
      <a href="/blog/" class="header__nav-link">Blog</a>
      <a href="/#contacto" class="header__nav-link header__nav-link--cta">
        Escríbenos →
      </a>
    </nav>
  </div>
</div>

<script>
  const btn = document.getElementById('burger-btn');
  const nav = document.getElementById('main-nav');

  btn?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('header__nav--open');
    btn.setAttribute('aria-expanded', String(isOpen));
    btn.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
    btn.classList.toggle('header__burger--open', isOpen);
  });

  nav?.querySelectorAll('.header__nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      nav.classList.remove('header__nav--open');
      btn?.setAttribute('aria-expanded', 'false');
      btn?.setAttribute('aria-label', 'Abrir menú');
      btn?.classList.remove('header__burger--open');
    });
  });
</script>

<style lang="scss">
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: $color-primary;
    border-bottom: 1px solid rgba(7, 5, 35, 0.12);
    width: 100%;
    box-sizing: border-box;
  }

  .header__inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.125rem 3.5rem;
    gap: $spacing-xl;
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .header__logo-img {
    height: 40px;
    width: auto;
  }

  .header__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.375rem;
    flex-shrink: 0;
  }

  .header__burger-bar {
    display: block;
    width: 24px;
    height: 2px;
    background: $color-text-dark;
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
    transform-origin: center;
  }

  .header__burger--open {
    .header__burger-bar:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .header__burger-bar:nth-child(2) {
      opacity: 0;
      transform: scaleX(0);
    }
    .header__burger-bar:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: $spacing-xl;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .header__nav-link {
    font-family: $font-family;
    font-size: $font-size-sm;
    font-weight: 500;
    color: $color-text-dark;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    padding-bottom: 3px;
    transition: color 0.2s ease, border-color 0.2s ease;
    white-space: nowrap;

    &:hover {
      color: $color-secondary;
      border-bottom-color: $color-secondary;
    }

    &--cta {
      background: $color-secondary;
      color: $color-text-light;
      border-bottom: none;
      padding: 0.625rem 1.125rem;
      font-weight: 700;
      transition: background 0.2s ease, color 0.2s ease;

      &:hover {
        background: $color-accent;
        color: $color-text-light;
        border-bottom: none;
      }
    }
  }

  @media (max-width: 1200px) {
    .header__inner {
      padding: 1rem $spacing-xl;
    }

    .header__nav {
      gap: $spacing-lg;
    }

    .header__nav-link {
      font-size: 0.8rem;
    }
  }

  @media (max-width: 900px) {
    .header__inner {
      padding: 1rem $spacing-lg;
    }

    .header__nav {
      gap: $spacing-md;
    }
  }

  @media (max-width: 768px) {
    .header__inner {
      flex-wrap: wrap;
      padding: $spacing-md $spacing-lg;
      gap: 0;
    }

    .header__burger {
      display: flex;
    }

    .header__nav {
      display: none;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      width: 100%;
      padding: $spacing-sm 0 $spacing-md;

      &--open {
        display: flex;
      }
    }

    .header__nav-link {
      width: 100%;
      padding: 0.75rem 0;
      border-bottom: 1px solid rgba(7, 5, 35, 0.08);
      font-size: $font-size-sm;
      white-space: normal;

      &--cta {
        margin-top: $spacing-sm;
        width: auto;
        align-self: flex-start;
        border-bottom: none;
        padding: 0.625rem 1.125rem;
      }
    }
  }
</style>
