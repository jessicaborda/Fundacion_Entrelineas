---
// Activities — Instagram reels embed feed
// Para actualizar: reemplaza las URLs del array `reels` con los permalinks
// reales de Instagram (clic derecho → "Copiar enlace" en cada publicación).
// Cuando se migre el dominio, conectar con la Graph API en lugar de este array.
import SectionLabel from '@components/atoms/SectionLabel.astro';

const reels = [
  'https://www.instagram.com/reel/DZqsTMHNxAL/',
  'https://www.instagram.com/p/DZfnb_PEbsM/',
  'https://www.instagram.com/reel/DY2ob5uCHs-/',
];
---

<section class="activities" id="actividades">
  <div class="activities__inner">
    <div class="activities__header">
      <SectionLabel label="Actividades" />
      <h2 class="activities__title">
        Procesos de encuentro y formación
        que suceden <em class="activities__em">en comunidad</em>.
      </h2>
    </div>

    <div class="activities__feed">
      {reels.map((url) => (
        <div class="activities__embed-wrap">
          <blockquote
            class="instagram-media"
            data-instgrm-permalink={`${url}?utm_source=ig_embed&utm_campaign=loading`}
            data-instgrm-version="14"
            style="background:#fff; border:0; border-radius:3px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); margin:0; max-width:340px; min-width:326px; padding:0; width:100%;"
          ></blockquote>
        </div>
      ))}
    </div>

    <div class="activities__cta">
      <a
        href="https://www.instagram.com/fundacion_entrelineas"
        target="_blank"
        rel="noopener"
        class="activities__ig-link"
      >
        Ver más en Instagram →
      </a>
    </div>
  </div>
</section>

<script async src="//www.instagram.com/embed.js"></script>

<style lang="scss">
  .activities {
    background-color: $color-editorial;
    padding: $spacing-section;
  }

  .activities__inner {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: $spacing-2xl;
  }

  .activities__header {
    display: flex;
    flex-direction: column;
    gap: $spacing-lg;
  }

  .activities__title {
    font-family: $font-family-serif;
    font-weight: 400;
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: $color-text-dark;
    margin: 0;
    max-width: 600px;
  }

  .activities__em {
    font-style: italic;
    color: $color-accent;
  }

  .activities__feed {
    display: flex;
    gap: $spacing-xl;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: $spacing-sm;

    // Ocultar scrollbar visualmente pero mantener funcionalidad
    scrollbar-width: thin;
    scrollbar-color: $color-primary transparent;

    &::-webkit-scrollbar {
      height: 3px;
    }

    &::-webkit-scrollbar-track {
      background: transparent;
    }

    &::-webkit-scrollbar-thumb {
      background: $color-primary;
    }
  }

  .activities__embed-wrap {
    flex: 0 0 auto;
    scroll-snap-align: start;
    width: 340px;

    // Mientras cargan los embeds de Instagram
    min-height: 500px;
    display: flex;
    align-items: flex-start;
  }

  .activities__cta {
    display: flex;
    justify-content: flex-end;
  }

  .activities__ig-link {
    font-family: $font-family;
    font-size: $font-size-sm;
    font-weight: 700;
    color: $color-text-dark;
    text-decoration: none;
    border-bottom: 2px solid $color-primary;
    padding-bottom: 2px;
    transition: color 0.2s ease, border-color 0.2s ease;

    &:hover {
      color: $color-accent;
      border-bottom-color: $color-accent;
    }
  }

  @media (max-width: 768px) {
    .activities {
      padding: $spacing-xl 0;
    }

    .activities__header {
      padding: 0 $spacing-lg;
    }

    .activities__feed {
      gap: $spacing-lg;
    }

    .activities__embed-wrap {
      width: 300px;
      min-height: 460px;
    }
  }
</style>
