---
// Activities — feed de Instagram vía Graph API (src/lib/instagram.ts)
// El feed se carga client-side desde /api/instagram/posts cuando la sección
// entra en el viewport. Requiere INSTAGRAM_ACCESS_TOKEN e
// INSTAGRAM_BUSINESS_ACCOUNT_ID configurados en el entorno (ver .env.example).
import SectionLabel from '@components/atoms/SectionLabel.astro';
---

<section class="activities" id="actividades" data-reveal>
  <div class="activities__inner">
    <div class="activities__header">
      <SectionLabel label="Actividades" />
      <h2 class="activities__title">
        Procesos de encuentro y formación
        que suceden <em class="activities__em">en comunidad</em>.
      </h2>
    </div>

    <div class="activities__feed" data-activities-feed>
      <p class="activities__placeholder">Cargando publicaciones…</p>
    </div>

    <div class="activities__cta">
      <a
        href="https://www.instagram.com/fundacion_entrelineas"
        target="_blank"
        rel="noopener"
        class="activities__ig-link"
      >
        Ver más en Instagram →
      </a>
    </div>
  </div>
</section>

<script>
  interface InstagramPost {
    id: string;
    caption: string;
    mediaType: 'IMAGE' | 'VIDEO' | 'CAROUSEL_ALBUM';
    mediaUrl: string;
    permalink: string;
    timestamp: string;
  }

  const section = document.querySelector('.activities');
  const feed = document.querySelector<HTMLElement>('[data-activities-feed]');

  function truncate(text: string, max: number) {
    if (text.length <= max) return text;
    return `${text.slice(0, max).trimEnd()}…`;
  }

  function renderPosts(posts: InstagramPost[]) {
    if (!feed) return;

    if (!posts.length) {
      feed.innerHTML = '<p class="activities__placeholder">No hay publicaciones disponibles en este momento.</p>';
      return;
    }

    feed.innerHTML = posts
      .map((post) => `
        <a
          class="activities__card"
          href="${post.permalink}"
          target="_blank"
          rel="noopener"
          aria-label="Ver publicación en Instagram"
        >
          <img
            class="activities__card-img"
            src="${post.mediaUrl}"
            alt="${truncate(post.caption, 100).replace(/"/g, '&quot;')}"
            loading="lazy"
          />
          ${post.caption ? `<span class="activities__card-caption">${truncate(post.caption, 90)}</span>` : ''}
        </a>
      `)
      .join('');
  }

  async function loadPosts() {
    try {
      const res = await fetch('/api/instagram/posts?limit=6');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const { posts } = await res.json();
      renderPosts(posts);
    } catch (err) {
      console.error('[activities]', err);
      if (feed) feed.innerHTML = '<p class="activities__placeholder">No pudimos cargar Instagram en este momento.</p>';
    }
  }

  if (section && feed) {
    const io = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        loadPosts();
        io.disconnect();
      }
    }, { rootMargin: '200px' });

    io.observe(section);
  }
</script>

<style lang="scss">
  .activities {
    background-color: $color-editorial;
    padding: $spacing-section;
  }

  .activities__inner {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: $spacing-2xl;
  }

  .activities__header {
    display: flex;
    flex-direction: column;
    gap: $spacing-lg;
  }

  .activities__title {
    font-family: $font-family-serif;
    font-weight: 400;
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: $color-text-dark;
    margin: 0;
    max-width: 600px;
  }

  .activities__em {
    font-style: italic;
    color: $color-accent;
  }

  .activities__feed {
    display: flex;
    gap: $spacing-xl;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: $spacing-sm;

    // Ocultar scrollbar visualmente pero mantener funcionalidad
    scrollbar-width: thin;
    scrollbar-color: $color-primary transparent;

    &::-webkit-scrollbar {
      height: 3px;
    }

    &::-webkit-scrollbar-track {
      background: transparent;
    }

    &::-webkit-scrollbar-thumb {
      background: $color-primary;
    }
  }

  .activities__placeholder {
    font-family: $font-family;
    font-size: $font-size-sm;
    color: $color-text-dark;
    opacity: 0.6;
  }

  .activities__card {
    flex: 0 0 340px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: $spacing-sm;
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background-color: #fff;
    box-shadow: 0 0 1px 0 rgba(0, 0, 0, 0.5), 0 1px 10px 0 rgba(0, 0, 0, 0.15);
    transition: transform 0.2s ease;

    &:hover {
      transform: translateY(-2px);
    }
  }

  .activities__card-img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
  }

  .activities__card-caption {
    font-family: $font-family;
    font-size: $font-size-sm;
    color: $color-text-dark;
    padding: 0 $spacing-sm $spacing-sm;
  }

  .activities__cta {
    display: flex;
    justify-content: flex-end;
  }

  .activities__ig-link {
    font-family: $font-family;
    font-size: $font-size-sm;
    font-weight: 700;
    color: $color-text-dark;
    text-decoration: none;
    border-bottom: 2px solid $color-primary;
    padding-bottom: 2px;
    transition: color 0.2s ease, border-color 0.2s ease;

    &:hover {
      color: $color-accent;
      border-bottom-color: $color-accent;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .activities {
      padding: $spacing-2xl 0;
    }

    .activities__header {
      padding: 0 $spacing-xl;
    }

    .activities__feed {
      gap: $spacing-xl;
      padding-left: $spacing-xl;
      padding-right: $spacing-xl;
      scroll-padding-left: $spacing-xl;
    }
  }

  @media (max-width: 768px) {
    .activities {
      padding: $spacing-xl 0;
    }

    .activities__header {
      padding: 0 $spacing-lg;
    }

    .activities__feed {
      gap: $spacing-lg;
      padding-left: $spacing-lg;
      padding-right: $spacing-lg;
      scroll-padding-left: $spacing-lg;
    }

    .activities__card {
      flex-basis: 260px;
    }
  }
</style>
