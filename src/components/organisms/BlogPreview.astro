---
// BlogPreview — shows the 3 most recent posts on the homepage
import { getCollection } from 'astro:content';
import SectionLabel from '@components/atoms/SectionLabel.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<section class="blog-preview" id="blog">
  <div class="blog-preview__header">
    <SectionLabel label="Escrituras entre líneas" />
    <h2 class="blog-preview__title">
      Un espacio para compartir el pensamiento
      que nace de <em class="blog-preview__em">nuestras actividades</em>.
    </h2>
  </div>

  <div class="blog-preview__grid">
    {posts.map(post => {
      const date = post.data.pubDate.toLocaleDateString('es-CO', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });
      return (
        <article class="bp-card">
          <div class="bp-card__header">
            <span class="bp-card__category">{post.data.category}</span>
            <time class="bp-card__date" datetime={post.data.pubDate.toISOString()}>{date}</time>
          </div>
          <h3 class="bp-card__title">
            <a href={`/Fundacion_Entrelineas/blog/${post.slug}/`}>{post.data.title}</a>
          </h3>
          <p class="bp-card__desc">{post.data.description}</p>
          <div class="bp-card__footer">
            <span class="bp-card__author">{post.data.author}</span>
            <a href={`/Fundacion_Entrelineas/blog/${post.slug}/`} class="bp-card__link">
              Leer más →
            </a>
          </div>
        </article>
      );
    })}
  </div>

  <div class="blog-preview__cta">
    <a href="/Fundacion_Entrelineas/blog/" class="blog-preview__btn">
      Ver todas las publicaciones
    </a>
  </div>
</section>

<style lang="scss">
  .blog-preview {
    background-color: $color-editorial;
    padding: $spacing-section;
  }

  .blog-preview__header {
    max-width: 1120px;
    margin: 0 auto $spacing-2xl;
    display: flex;
    flex-direction: column;
    gap: $spacing-lg;
  }

  .blog-preview__title {
    font-family: $font-family-serif;
    font-weight: 400;
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: $color-text-dark;
    margin: 0;
    max-width: 680px;
  }

  .blog-preview__em {
    font-style: italic;
  }

  .blog-preview__grid {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: $spacing-xl;
  }

  .bp-card {
    background: #ffffff;
    border: 1px solid rgba(7, 5, 35, 0.1);
    padding: $spacing-xl;
    display: flex;
    flex-direction: column;
    gap: $spacing-md;
    transition: transform 0.2s ease, box-shadow 0.2s ease;

    &:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(7, 5, 35, 0.08);
    }
  }

  .bp-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: $spacing-sm;
    flex-wrap: wrap;
  }

  .bp-card__category {
    display: inline-block;
    background: $color-primary;
    color: $color-text-dark;
    font-family: $font-family;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .bp-card__date {
    font-family: $font-family;
    font-size: $font-size-sm;
    color: rgba(7, 5, 35, 0.45);
  }

  .bp-card__title {
    font-family: $font-family-serif;
    font-size: $font-size-xl;
    font-weight: 500;
    margin: 0;
    line-height: 1.3;
    flex: 1;

    a {
      color: $color-text-dark;
      text-decoration: none;
      transition: color 0.2s ease;

      &:hover {
        color: $color-secondary;
      }
    }
  }

  .bp-card__desc {
    font-family: $font-family;
    font-size: $font-size-base;
    color: rgba(7, 5, 35, 0.65);
    margin: 0;
    line-height: 1.6;
    flex: 1;
  }

  .bp-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: $spacing-md;
    border-top: 1px solid rgba(7, 5, 35, 0.08);
    flex-wrap: wrap;
    gap: $spacing-sm;
  }

  .bp-card__author {
    font-family: $font-family;
    font-size: $font-size-sm;
    color: rgba(7, 5, 35, 0.45);
  }

  .bp-card__link {
    font-family: $font-family;
    font-size: $font-size-sm;
    font-weight: 700;
    color: $color-secondary;
    text-decoration: none;
    transition: color 0.2s ease;

    &:hover {
      color: $color-primary;
    }
  }

  .blog-preview__cta {
    max-width: 1120px;
    margin: $spacing-2xl auto 0;
    display: flex;
    justify-content: center;
  }

  .blog-preview__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: $color-text-dark;
    color: $color-primary;
    font-family: $font-family;
    font-size: $font-size-sm;
    font-weight: 700;
    padding: 0.875rem $spacing-xl;
    text-decoration: none;
    transition: opacity 0.2s ease;

    &:hover {
      opacity: 0.85;
    }
  }

  @media (max-width: 900px) {
    .blog-preview__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .blog-preview {
      padding: $spacing-xl 0;
    }

    .blog-preview__header {
      padding: 0 $spacing-lg;
    }

    .blog-preview__header :global(.section-label) {
      padding-left: 0;
    }

    .blog-preview__grid {
      display: flex;
      flex-direction: row;
      max-width: none;
      margin: 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-left: $spacing-lg;
      -webkit-overflow-scrolling: touch;
      padding-left: $spacing-lg;
      gap: $spacing-lg;
    }

    .bp-card {
      flex: 0 0 75vw;
      scroll-snap-align: start;

      &:last-child {
        margin-right: $spacing-lg;
      }
    }

    .blog-preview__cta {
      padding: 0 $spacing-lg;
      margin-top: $spacing-xl;
    }
  }
</style>
