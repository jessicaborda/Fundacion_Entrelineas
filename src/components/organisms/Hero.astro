---
// Hero — brand-aligned editorial (Manual de Marca 2024)
import { Image } from 'astro:assets';
import heroImage from '@assets/images/hero-image.jpg';
---

<section class="hero" id="hero">
  <div class="hero__content">
    <div class="hero__eyebrow">
      <span class="hero__eyebrow-line"></span>
      <span class="hero__eyebrow-text">Fundación cultural · Tunja, desde 2010</span>
    </div>

    <h1 class="hero__title">
      Leemos para
      <em class="hero__title-highlight">entendernos</em>,<br/>
      escribimos para <em class="hero__title-italic">quedarnos</em>.
    </h1>

    <p class="hero__description">
      Somos un laboratorio de democracia que sostiene la cultura como derecho.
      Tertulias, filosofía, festivales y escritura para construir, entre lectores,
      la singularidad de cada uno.
    </p>

    <div class="hero__actions">
      <a href="/#que-hacemos" class="hero__btn hero__btn--primary">
        Conoce qué hacemos →
      </a>
      <a href="/#actividades" class="hero__btn hero__btn--secondary">
        Próximas actividades
      </a>
    </div>

    <div class="hero__stats">
      <div class="hero__stat">
        <span class="hero__stat-n">15</span>
        <span class="hero__stat-l">años tejiendo lectura</span>
      </div>
      <div class="hero__stat">
        <span class="hero__stat-n">120+</span>
        <span class="hero__stat-l">encuentros al año</span>
      </div>
    </div>
  </div>

  <div class="hero__image-wrap">
    <Image
      src={heroImage}
      alt="Encuentro de lectura Entrelíneas"
      class="hero__image"
    />
    <div class="hero__corner hero__corner--tl"></div>
    <div class="hero__corner hero__corner--br"></div>
    <blockquote class="hero__quote">
      <span class="hero__quote-mark">"</span>
      Una tertulia es un país pequeño donde todos podemos hablar.
    </blockquote>
  </div>
</section>

<style lang="scss">
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    background-color: $color-editorial;
    border-bottom: 1px solid rgba(7, 5, 35, 0.08);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 6rem 3.5rem;
    gap: $spacing-xl;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hero__eyebrow-line {
    display: block;
    width: 2.25rem;
    height: 1px;
    background: $color-text-dark;
  }

  .hero__eyebrow-text {
    font-family: $font-family-heading;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: $color-text-dark;
  }

  .hero__title {
    font-family: $font-family-serif;
    font-weight: 500;
    font-size: clamp(2.75rem, 5.6vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: $color-text-dark;
    margin: 0;
  }

  .hero__title-highlight {
    font-style: italic;
    font-weight: 400;
    position: relative;
    display: inline;

    &::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0.05em;
      height: 0.32em;
      background: $color-primary;
      z-index: -1;
      transform: skew(-2deg);
    }
  }

  .hero__title-italic {
    font-style: italic;
    font-weight: 400;
  }

  .hero__description {
    font-family: $font-family-heading;
    font-size: $font-size-lg;
    line-height: 1.55;
    color: rgba(7, 5, 35, 0.72);
    margin: 0;
    max-width: 520px;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: $spacing-lg;
    flex-wrap: wrap;
  }

  .hero__btn {
    font-family: $font-family-heading;
    font-size: $font-size-sm;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s ease;

    &--primary {
      background: $color-text-dark;
      color: $color-primary;
      padding: 1rem $spacing-xl;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;

      &:hover { opacity: 0.88; }
    }

    &--secondary {
      color: $color-text-dark;
      text-decoration: underline;
      text-underline-offset: 6px;
      text-decoration-thickness: 2px;
      text-decoration-color: $color-primary;
      padding: 1rem 0;

      &:hover { opacity: 0.7; }
    }
  }

  .hero__stats {
    display: flex;
    gap: 3rem;
    padding-top: $spacing-xl;
    border-top: 1px solid rgba(7, 5, 35, 0.12);
  }

  .hero__stat {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .hero__stat-n {
    font-family: $font-family-serif;
    font-size: 2.5rem;
    font-weight: 500;
    color: $color-text-dark;
    line-height: 1;
  }

  .hero__stat-l {
    font-family: $font-family-heading;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(7, 5, 35, 0.6);
  }

  .hero__image-wrap {
    position: relative;
    overflow: hidden;
    background: $color-accent;
    min-height: 520px;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    filter: grayscale(100%) contrast(1.05);
  }

  .hero__corner {
    position: absolute;
    width: 88px;
    height: 88px;

    &--tl {
      top: -1px;
      left: -1px;
      border-top: 4px solid $color-primary;
      border-left: 4px solid $color-primary;
    }

    &--br {
      bottom: -1px;
      right: -1px;
      border-bottom: 4px solid $color-primary;
      border-right: 4px solid $color-primary;
    }
  }

  .hero__quote {
    position: absolute;
    left: $spacing-lg;
    right: $spacing-lg;
    bottom: $spacing-lg;
    margin: 0;
    background: $color-secondary;
    color: $color-primary;
    padding: 0.875rem $spacing-lg;
    font-family: $font-family-heading;
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .hero__quote-mark {
    font-family: $font-family-serif;
    font-style: italic;
    font-size: 1.1rem;
    margin-right: 0.25rem;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero__image-wrap {
      min-height: 320px;
    }

    .hero__content {
      padding: $spacing-xl $spacing-lg;
      gap: $spacing-lg;
    }

    .hero__stats {
      gap: $spacing-xl;
    }

    .hero__title {
      font-size: clamp(2rem, 8vw, 3rem);
    }
  }

  @media (max-width: 480px) {
    .hero__actions {
      justify-content: center;
    }

    .hero__stats {
      flex-wrap: wrap;
      gap: $spacing-lg;
      justify-content: center;
    }

    .hero__stat {
      align-items: center;
      text-align: center;
    }
  }
</style>
