---
// YouTube — dark editorial video section
import SectionLabel from '@components/atoms/SectionLabel.astro';
import { Image } from 'astro:assets';

const videos = [
  {
    id: 'ZnVzkRtL3QQ',
    series: 'Conferencia',
    title: 'La debilidad cultural de Colombia como condición de su exacerbada violencia',
    meta: 'Carlos Mario González · Fundación Entrelíneas',
  },
  {
    id: 'ChSiK6Ub-jA',
    series: 'Conversación',
    title: 'Conversación con Mauricio Archila sobre Idas y venidas, vueltas y revueltas',
    meta: 'Mauricio Archila · Fundación Entrelíneas',
  },
  {
    id: '-XXtIvDUIK8',
    series: 'Video ensayo',
    title: 'Viaje a pie de Fernando González',
    meta: 'Leer a Colombia: Letras y filosofía colombianas',
  },
];
---

<section class="yt" id="videos" data-reveal>
  <div class="yt__header">
    <div>
      <SectionLabel label="Aprender, ver, escuchar" light={true} />
      <h2 class="yt__title">
        El conocimiento <em class="yt__em">circula</em>.
        Conferencias, lecturas y conversaciones.
      </h2>
    </div>
    <a href="https://www.youtube.com/@fundacionentrelineas3295" target="_blank" rel="noopener" class="yt__channel-link">
      Explora nuestro canal →
    </a>
  </div>

  <div class="yt__cards">
    {videos.map((v) => (
      <a
        class="yt-card"
        href={`https://www.youtube.com/watch?v=${v.id}`}
        target="_blank"
        rel="noopener"
        aria-label={`Ver video: ${v.title}`}
      >
        <div class="yt-card__thumb">
          <Image
            src={`https://img.youtube.com/vi/${v.id}/hqdefault.jpg`}
            alt={v.title}
            class="yt-card__thumb-img"
            width={480}
            height={360}
            loading="lazy"
          />
          <div class="yt-card__play">
            <svg width="18" height="20" viewBox="0 0 20 22" aria-hidden="true">
              <polygon points="0,0 20,11 0,22" fill="#070523"/>
            </svg>
          </div>
        </div>
        <div class="yt-card__body">
          <span class="yt-card__series">{v.series}</span>
          <h3 class="yt-card__title">{v.title}</h3>
          <p class="yt-card__meta">{v.meta}</p>
        </div>
      </a>
    ))}
  </div>
</section>

<style lang="scss">
  .yt {
    background-color: $color-secondary;
    padding: $spacing-section;
  }

  .yt__header {
    max-width: 1120px;
    margin: 0 auto $spacing-2xl;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: $spacing-xl;
    flex-wrap: wrap;
  }

  .yt__title {
    font-family: $font-family-serif;
    font-weight: 400;
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: $color-text-light;
    margin: $spacing-md 0 0;
    max-width: 600px;
  }

  .yt__em {
    font-style: italic;
    color: $color-primary;
  }

  .yt__channel-link {
    font-family: $font-family;
    font-size: $font-size-sm;
    font-weight: 700;
    color: $color-primary;
    text-decoration: underline;
    text-underline-offset: 6px;
    white-space: nowrap;
    flex-shrink: 0;
    align-self: flex-end;

    &:hover { opacity: 0.8; }
  }

  .yt__cards {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: $spacing-xl;
  }

  .yt-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;

    &:hover .yt-card__thumb-img {
      transform: scale(1.04);
    }

    &:hover .yt-card__play {
      transform: translate(-50%, -50%) scale(1.1);
    }
  }

  .yt-card__thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: $color-accent;
  }

  .yt-card__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .yt-card__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: $color-primary;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s ease;
  }

  .yt-card__body {
    padding: $spacing-md 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .yt-card__series {
    font-family: $font-family;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: $color-primary;
  }

  .yt-card__title {
    font-family: $font-family-serif;
    font-weight: 500;
    font-size: $font-size-xl;
    line-height: 1.2;
    color: $color-text-light;
    margin: 0;
  }

  .yt-card__meta {
    font-family: $font-family;
    font-size: $font-size-sm;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
  }

  @media (max-width: 900px) {
    .yt__cards {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .yt {
      padding: $spacing-xl 0;
    }

    .yt__header {
      flex-direction: column;
      align-items: flex-start;
      padding: 0 $spacing-lg;
    }

    .yt__cards {
      display: flex;
      flex-direction: row;
      max-width: none;
      margin: 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-left: $spacing-lg;
      -webkit-overflow-scrolling: touch;
      padding-left: $spacing-lg;
    }

    .yt-card {
      flex: 0 0 75vw;
      scroll-snap-align: start;

      &:last-child {
        margin-right: $spacing-lg;
      }
    }
  }
</style>
