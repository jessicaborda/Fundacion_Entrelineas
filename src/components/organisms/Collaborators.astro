---
// Collaborators — editorial light-background layout
import SectionLabel from '@components/atoms/SectionLabel.astro';
---

<section class="collaborators" id="colaboradores">
  <!-- Team -->
  <div class="team">
    <div class="team__inner">
      <SectionLabel label="Quienes soñaron Entrelíneas" />
      <h2 class="team__title">
        Investigadores, docentes y gestores haciendo
        de la lectura un <em class="team__em">puente</em>.
      </h2>

      <div class="team__cards">
        <div class="team__card">
          <div class="team__img-wrap">
            <img
              src="/Fundacion_Entrelineas/equipo/miguel_angel.jpg"
              alt="Miguel Ángel Palacios Quitián"
              class="team__img"
            />
            <span class="team__num">01</span>
          </div>
          <h3 class="team__name">Miguel Ángel Palacios Quitián</h3>
          <p class="team__role">Director General</p>
          <p class="team__bio">
            Investigador y gestor cultural. Lidera los procesos de formación y las
            tertulias literarias desde los inicios de la fundación.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Partners -->
  <div class="partners">
    <div class="partners__inner">
      <SectionLabel label="Caminamos acompañados" />
      <h2 class="partners__title">
        Colaboradores que sostienen el proyecto con nosotros.
      </h2>

      <div class="partners__grid">
        <div class="partners__card">
          <div class="partners__logo-wrap">
            <img
              src="/Fundacion_Entrelineas/colaboradores/logo_umbral.png"
              alt="Café Librería Umbral"
              class="partners__logo"
            />
          </div>
          <div class="partners__info">
            <h3 class="partners__name">Café Librería Umbral</h3>
            <p class="partners__type">Aliado cultural</p>
          </div>
          <div class="partners__socials">
            <a href="https://www.instagram.com/umbralibreria" target="_blank" rel="noopener" class="partners__social-btn" title="@umbralibreria">IG</a>
            <a href="https://www.facebook.com/search/top?q=Caf%C3%A9+Librer%C3%ADa+Umbral" target="_blank" rel="noopener" class="partners__social-btn" title="Café Librería Umbral en Facebook">FB</a>
          </div>
        </div>

        <div class="partners__card">
          <div class="partners__logo-wrap partners__logo-wrap--photo">
            <img
              src="/Fundacion_Entrelineas/colaboradores/foto_colaborador.jpg"
              alt="Grupo de Estudios Psicoanalíticos Sigmund Freud"
              class="partners__logo"
            />
          </div>
          <div class="partners__info">
            <h3 class="partners__name">Grupo de Estudios Psicoanalíticos "Sigmund Freud"</h3>
            <p class="partners__type">Aliado académico</p>
          </div>
          <div class="partners__socials">
            <a href="https://www.instagram.com/gepsigmundfreud" target="_blank" rel="noopener" class="partners__social-btn" title="@gepsigmundfreud">IG</a>
            <a href="https://www.facebook.com/search/top?q=Grupo+de+Estudios+Psicoanal%C3%ADticos+Sigmund+Freud" target="_blank" rel="noopener" class="partners__social-btn" title="Grupo de Estudios Psicoanalíticos Sigmund Freud en Facebook">FB</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .collaborators {
    display: flex;
    flex-direction: column;
  }

  // Team (dark)
  .team {
    background-color: $color-secondary;
    padding: $spacing-section;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .team__inner {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: $spacing-xl;
  }

  .team__title {
    font-family: $font-family-serif;
    font-weight: 400;
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: $color-text-light;
    margin: 0;
    max-width: 640px;
  }

  .team__em {
    font-style: italic;
    color: $color-primary;
  }

  .team__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: $spacing-2xl;
  }

  .team__card {
    display: flex;
    flex-direction: column;
    gap: $spacing-sm;
  }

  .team__img-wrap {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: $color-accent;
  }

  .team__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  .team__num {
    position: absolute;
    left: 0;
    bottom: 0;
    background: $color-primary;
    color: $color-text-dark;
    font-family: $font-family;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 0.375rem 0.625rem;
  }

  .team__name {
    font-family: $font-family-serif;
    font-weight: 500;
    font-size: $font-size-xl;
    color: $color-text-light;
    margin: $spacing-md 0 0;
  }

  .team__role {
    font-family: $font-family;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
  }

  .team__bio {
    font-family: $font-family;
    font-size: $font-size-sm;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin: $spacing-sm 0 0;
  }

  // Partners (light editorial)
  .partners {
    background-color: $color-editorial;
    padding: $spacing-section;
    border-top: 1px solid rgba(7, 5, 35, 0.08);
  }

  .partners__inner {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: $spacing-xl;
  }

  .partners__title {
    font-family: $font-family-serif;
    font-weight: 400;
    font-size: clamp(1.4rem, 2.2vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: $color-text-dark;
    margin: 0;
    max-width: 520px;
  }

  .partners__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: $spacing-lg;
  }

  .partners__card {
    border: 1px solid $color-text-dark;
    padding: $spacing-xl $spacing-lg;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: $spacing-lg;
    align-items: center;
    background: $color-editorial;
  }

  .partners__logo-wrap {
    width: 64px;
    height: 64px;
    background: $color-primary;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;

    &--photo {
      border-radius: 50%;
      overflow: hidden;
      background: $color-accent;
    }
  }

  .partners__logo {
    width: 100%;
    height: 100%;
    object-fit: contain;

    .partners__logo-wrap--photo & {
      object-fit: cover;
    }
  }

  .partners__info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .partners__name {
    font-family: $font-family-serif;
    font-weight: 500;
    font-size: $font-size-lg;
    color: $color-text-dark;
    margin: 0;
  }

  .partners__type {
    font-family: $font-family;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(7, 5, 35, 0.55);
    margin: 0;
  }

  .partners__socials {
    display: flex;
    gap: $spacing-sm;
  }

  .partners__social-btn {
    width: 38px;
    height: 38px;
    border: 1px solid $color-text-dark;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: $font-family;
    font-size: 0.7rem;
    font-weight: 700;
    color: $color-text-dark;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;

    &:hover {
      background: $color-text-dark;
      color: $color-primary;
    }
  }

  @media (max-width: 900px) {
    .team__cards {
      grid-template-columns: 1fr;
      max-width: 400px;
    }

    .partners__grid {
      grid-template-columns: 1fr;
    }

    .partners__card {
      grid-template-columns: auto 1fr;
      grid-template-rows: auto auto;
    }

    .partners__socials {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .team,
    .partners {
      padding: $spacing-xl;
    }
  }
</style>
