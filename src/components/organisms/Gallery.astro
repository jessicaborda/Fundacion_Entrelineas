---
// Gallery with editorial light background + lightbox
import SectionLabel from '@components/atoms/SectionLabel.astro';

const images = [
  { src: '/Fundacion_Entrelineas/galeria/img_01.jpg', alt: 'Tertulia literaria Entrelíneas' },
  { src: '/Fundacion_Entrelineas/galeria/img_05.jpg', alt: 'Encuentro cultural Entrelíneas' },
  { src: '/Fundacion_Entrelineas/galeria/img_07.jpg', alt: 'Actividad Entrelíneas' },
  { src: '/Fundacion_Entrelineas/galeria/img_13.jpg', alt: 'Festival de lectura' },
  { src: '/Fundacion_Entrelineas/galeria/img_15.jpg', alt: 'Café filosófico' },
  { src: '/Fundacion_Entrelineas/galeria/img_17.jpg', alt: 'Taller de escritura' },
  { src: '/Fundacion_Entrelineas/galeria/img_19.jpg', alt: 'Promotores de lectura' },
  { src: '/Fundacion_Entrelineas/galeria/img_23.jpg', alt: 'Comunidad lectora Entrelíneas' },
];
---

<section class="gallery" id="galeria">
  <div class="gallery__header">
    <SectionLabel label="Galería" />
    <h2 class="gallery__title">
      Momentos en los que la cultura <em class="gallery__em">cobró vida</em>.
    </h2>
  </div>

  <div class="gallery__mosaic">
    {images.map((img, i) => (
      <button
        class="gallery__btn"
        data-index={i}
        aria-label={`Ver imagen: ${img.alt}`}
      >
        <img src={img.src} alt={img.alt} class="gallery__img" loading="lazy" />
      </button>
    ))}
  </div>
</section>

<!-- Lightbox -->
<div class="lightbox" id="gallery-lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Galería de imágenes">
  <button class="lightbox__close" id="lightbox-close" aria-label="Cerrar">✕</button>

  <button class="lightbox__nav lightbox__nav--prev" id="lightbox-prev" aria-label="Imagen anterior">‹</button>
  <button class="lightbox__nav lightbox__nav--next" id="lightbox-next" aria-label="Imagen siguiente">›</button>

  <div class="lightbox__track" id="lightbox-track">
    {images.map((img, i) => (
      <div class="lightbox__slide" data-index={i}>
        <img src={img.src} alt={img.alt} class="lightbox__img" />
      </div>
    ))}
  </div>

  <div class="lightbox__counter" id="lightbox-counter">1 / {images.length}</div>
</div>

<script>
  const lightbox = document.getElementById('gallery-lightbox')!;
  const track    = document.getElementById('lightbox-track')!;
  const lbClose  = document.getElementById('lightbox-close')!;
  const lbPrev   = document.getElementById('lightbox-prev')!;
  const lbNext   = document.getElementById('lightbox-next')!;
  const counter  = document.getElementById('lightbox-counter')!;
  const total    = track.querySelectorAll('.lightbox__slide').length;
  let current    = 0;

  function goTo(index: number, animate = true) {
    current = (index + total) % total;
    track.scrollTo({ left: current * track.clientWidth, behavior: animate ? 'smooth' : 'instant' });
    counter.textContent = `${current + 1} / ${total}`;
    lbPrev.setAttribute('aria-disabled', current === 0 ? 'true' : 'false');
    lbNext.setAttribute('aria-disabled', current === total - 1 ? 'true' : 'false');
  }

  function open(index: number) {
    lightbox.classList.add('lightbox--open');
    lightbox.setAttribute('aria-hidden', 'false');
    goTo(index, false);
    lbClose.focus();
  }

  function close() {
    lightbox.classList.remove('lightbox--open');
    lightbox.setAttribute('aria-hidden', 'true');
  }

  // Sync counter on mobile swipe
  let scrollTimer: ReturnType<typeof setTimeout>;
  track.addEventListener('scroll', () => {
    clearTimeout(scrollTimer);
    scrollTimer = setTimeout(() => {
      const index = Math.round(track.scrollLeft / track.clientWidth);
      if (index !== current) {
        current = index;
        counter.textContent = `${current + 1} / ${total}`;
        lbPrev.setAttribute('aria-disabled', current === 0 ? 'true' : 'false');
        lbNext.setAttribute('aria-disabled', current === total - 1 ? 'true' : 'false');
      }
    }, 80);
  });

  document.querySelectorAll<HTMLButtonElement>('.gallery__btn').forEach(btn => {
    btn.addEventListener('click', () => open(Number(btn.dataset.index)));
  });

  lbPrev.addEventListener('click', () => goTo(current - 1));
  lbNext.addEventListener('click', () => goTo(current + 1));
  lbClose.addEventListener('click', close);

  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) close(); });

  document.addEventListener('keydown', (e) => {
    if (!lightbox.classList.contains('lightbox--open')) return;
    if (e.key === 'Escape')     close();
    if (e.key === 'ArrowLeft')  goTo(current - 1);
    if (e.key === 'ArrowRight') goTo(current + 1);
  });
</script>

<style lang="scss">
  .gallery {
    background-color: $color-editorial;
    padding: $spacing-section;
  }

  .gallery__header {
    max-width: 1120px;
    margin: 0 auto $spacing-2xl;
    display: flex;
    flex-direction: column;
    gap: $spacing-lg;
  }

  .gallery__title {
    font-family: $font-family-serif;
    font-weight: 400;
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: $color-text-dark;
    margin: 0;
    max-width: 640px;
  }

  .gallery__em {
    font-style: italic;
  }

  .gallery__mosaic {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 182px;
    gap: $spacing-sm;
  }

  // Primera imagen: destacada (2 col × 2 row)
  .gallery__btn:nth-child(1) {
    grid-column: span 2;
    grid-row: span 2;
  }

  // Última imagen: ancho doble para cerrar la tercera fila
  .gallery__btn:nth-child(8) {
    grid-column: span 2;
  }

  .gallery__btn {
    border: 0;
    padding: 0;
    cursor: pointer;
    overflow: hidden;
    background: $color-accent;
    position: relative;

    &:hover .gallery__img {
      transform: scale(1.05);
    }

    &:focus-visible {
      outline: 3px solid $color-primary;
      outline-offset: 2px;
    }
  }

  .gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  // Lightbox
  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(7, 5, 35, 0.96);
    z-index: 1000;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    &--open {
      display: flex;
    }
  }

  .lightbox__track {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .lightbox__slide {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    scroll-snap-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: $spacing-2xl 5rem;
    box-sizing: border-box;
  }

  .lightbox__img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    box-shadow: 0 0 0 3px $color-primary;
    display: block;
  }

  .lightbox__close {
    position: absolute;
    top: $spacing-lg;
    right: $spacing-lg;
    background: $color-primary;
    color: $color-text-dark;
    border: 0;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    z-index: 10;
    transition: background 0.2s ease, color 0.2s ease;

    &:hover {
      background: $color-text-dark;
      color: $color-primary;
    }
  }

  .lightbox__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: $color-primary;
    color: $color-text-dark;
    border: 0;
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
    z-index: 10;
    transition: background 0.2s ease, color 0.2s ease;

    &:hover {
      background: $color-text-dark;
      color: $color-primary;
    }

    &[aria-disabled='true'] {
      opacity: 0.25;
      pointer-events: none;
    }

    &--prev { left: $spacing-lg; }
    &--next { right: $spacing-lg; }
  }

  .lightbox__counter {
    position: absolute;
    bottom: $spacing-lg;
    left: 50%;
    transform: translateX(-50%);
    font-family: $font-family;
    font-size: $font-size-sm;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: $color-primary;
  }

  @media (max-width: 768px) {
    .gallery {
      padding: $spacing-xl;
    }

    .gallery__mosaic {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 160px;
    }

    .gallery__btn:nth-child(1),
    .gallery__btn:nth-child(8) {
      grid-column: span 1;
      grid-row: span 1;
    }

    .lightbox__nav {
      display: none;
    }

    .lightbox__slide {
      padding: 4rem $spacing-lg $spacing-2xl;
    }
  }
</style>
